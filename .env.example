# Fluxfield runtime
AUTH_SECRET=generate-a-long-random-string
AUTH_TRUST_HOST=true

# Leave true on a laptop / this VM. Unset on a public domain once Authelia is wired.
AUTH_DISABLED=true

# Bring-your-own Authelia OIDC client
AUTHELIA_ISSUER=https://auth.example.com
AUTHELIA_CLIENT_ID=fluxfield
AUTHELIA_CLIENT_SECRET=
# Optional: AUTHELIA_END_SESSION_URL=https://auth.example.com/logout

HOST=0.0.0.0
PORT=43127
